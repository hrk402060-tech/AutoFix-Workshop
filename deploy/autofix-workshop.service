[Unit]
Description=AutoFix Workshop Node service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/autofix-workshop/backend
EnvironmentFile=/etc/autofix-workshop.env
ExecStart=/usr/bin/node /opt/autofix-workshop/backend/dist/main.js
Restart=always
RestartSec=5
User=autofix
Group=autofix
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
ProtectSystem=strict
ReadWritePaths=/opt/autofix-workshop/data /opt/autofix-workshop/uploads
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target

